* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 20px;
}

.container {
    max-width: 900px;
    margin: 0 auto;
}

h1 {
    text-align: center;
    color: white;
    font-size: 2.2rem;
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.scoreboard {
    display: flex;
    justify-content: space-between;
    background: rgba(255,255,255,0.2);
    border-radius: 12px;
    padding: 12px 20px;
    margin-bottom: 20px;
    color: white;
    font-size: 1.1rem;
}

.card {
    background: white;
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.card h3 {
    color: #5a4a8a;
    margin-bottom: 12px;
    font-size: 1.1rem;
}

.welcome-card {
    text-align: center;
    padding: 40px;
}

.welcome-card h2 {
    color: #5a4a8a;
    font-size: 1.8rem;
    margin-bottom: 10px;
}

.welcome-card p {
    color: #666;
    margin-bottom: 20px;
    font-size: 1.1rem;
}

.welcome-card h3 {
    color: #5a4a8a;
    margin-bottom: 12px;
}

.instructions {
    text-align: left;
    list-style: none;
    margin-bottom: 30px;
    display: inline-block;
}

.instructions li {
    padding: 6px 0;
    color: #555;
    font-size: 1rem;
}

.instructions li::before {
    content: "▶ ";
    color: #667eea;
}

.game-area {
    display: flex;
    gap: 16px;
    align-items: flex-start;
}

.left-panel {
    flex: 1;
    min-width: 220px;
}

.right-panel {
    flex: 1.2;
}

.hint {
    color: #555;
    font-style: italic;
    font-size: 1rem;
}

.word-list {
    list-style: none;
}

.word-list li {
    padding: 6px 0;
    font-size: 1rem;
    border-bottom: 1px solid #f0f0f0;
}

.word-list li.found {
    color: #27ae60;
    font-weight: bold;
    text-decoration: line-through;
}

.word-list li.pending {
    color: #5a4a8a;
}

form input[type="text"] {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    margin-bottom: 10px;
    outline: none;
    transition: border 0.2s;
}

form input[type="text"]:focus {
    border-color: #667eea;
}

.btn-guess {
    width: 100%;
    padding: 10px;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-guess:hover {
    background: #5a6fd6;
}

.btn-start {
    display: inline-block;
    padding: 14px 36px;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1.2rem;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
    margin-top: 10px;
}

.btn-start:hover {
    background: #5a6fd6;
}

.btn-reset {
    display: inline-block;
    padding: 8px 20px;
    background: rgba(255,255,255,0.3);
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.2s;
}

.btn-reset:hover {
    background: rgba(255,255,255,0.5);
}

.message {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 0.95rem;
}

.message.success { background: #d4edda; color: #155724; }
.message.warning { background: #fff3cd; color: #856404; }
.message.error   { background: #f8d7da; color: #721c24; }

.grid {
    border-collapse: collapse;
    margin: 0 auto;
}

.grid td {
    width: 50px;
    height: 50px;
    text-align: center;
    vertical-align: middle;
    font-size: 1.3rem;
    font-weight: bold;
    color: #5a4a8a;
    border: 2px solid #e0d8f0;
    border-radius: 6px;
    background: #f8f5ff;
}

.game-over-card {
    text-align: center;
    padding: 40px;
}

.game-over-card h2 {
    color: #27ae60;
    font-size: 2rem;
    margin-bottom: 16px;
}

.final-score {
    font-size: 1.4rem;
    color: #5a4a8a;
    margin-bottom: 12px;
}

.reveal {
    font-size: 1.2rem;
    color: #555;
    margin-bottom: 20px;
    padding: 14px;
    background: #f0ecff;
    border-radius: 10px;
}

.footer {
    text-align: center;
    margin-top: 16px;
}

@media (max-width: 650px) {
    .game-area { flex-direction: column; }
    h1 { font-size: 1.5rem; }
}
.grid td { cursor: pointer; transition: background 0.15s; }
.grid td.cell-selected { background: #ffe066; color: #333; }
.grid td.cell-found { background: #b6f5c8; color: #155724; }
.grid-hint { text-align: center; color: #888; font-size: 0.85rem; margin-top: 10px; font-style: italic; }

